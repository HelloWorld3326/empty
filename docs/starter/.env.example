# 复制为 .env 后填写。.env 必须进 .gitignore，绝不提交。

# ---- 数据库 ----
DATABASE_URL=postgresql+psycopg2://agent:agent_dev_pwd@localhost:5432/agent_platform
REDIS_URL=redis://localhost:6379/0

# ---- 应用 ----
APP_ENV=dev
APP_SECRET_KEY=change_me_to_a_random_32_byte_string
JWT_EXPIRE_MINUTES=720
# 用于加密 resource_model.api_key_enc / resource_mcp.auth_secret_enc
CREDENTIAL_ENC_KEY=change_me_to_a_fernet_key

# ---- 阿里云百炼（OpenAI 兼容端点）----
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_LLM_MODEL=qwen-plus

# ---- 内网知识库（W1 未拿到接口前留空，走 mock 适配器）----
KNOWLEDGE_PROVIDER=mock          # mock | intranet
KNOWLEDGE_BASE_URL=
KNOWLEDGE_API_KEY=

# ---- 附件 ----
ATTACHMENT_DIR=./var/attachments
ATTACHMENT_MAX_MB=20
