# MaxKB 的 HTTP 节点必须带这个头，随机生成一串长字符串
TOOL_API_SERVICE_KEY=change-me-to-a-long-random-string

# 可选：如果走 tool_token 方案，需与 chat-gateway 的 TOOL_TOKEN_SECRET 一致
TOOL_TOKEN_SECRET=
TOOL_TOKEN_AUDIENCE=maxkb-tool-api

# 数据源：mock / db / http
TOOL_DATA_SOURCE=mock

# TOOL_DATA_SOURCE=db 时
TOOL_DB_DSN=postgresql+psycopg://user:password@127.0.0.1:5432/crm

# TOOL_DATA_SOURCE=http 时（转调客户360 已有接口）
TOOL_UPSTREAM_BASE_URL=http://customer360.internal/api
TOOL_UPSTREAM_TOKEN=
TOOL_UPSTREAM_TIMEOUT=8

# 数据要出内网给云端大模型，保持开启
TOOL_MASK_PII=true
