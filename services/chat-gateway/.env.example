# ---------------- MaxKB ----------------
# native = 原生接口（要查客户数据必须用这个）；openai = OpenAI 兼容接口（纯知识问答够用）
MAXKB_MODE=native
MAXKB_BASE_URL=http://127.0.0.1:8080
MAXKB_API_KEY=在 MaxKB 应用页面创建的 API Key
MAXKB_APP_ID=
MAXKB_TIMEOUT=120
# 各版本接口路径可能不同，对着你部署版本自带的 API 文档核对后改这里，不用改代码
MAXKB_PATH_PROFILE=/api/application/profile
MAXKB_PATH_OPEN=/api/application/{app_id}/chat/open
MAXKB_PATH_MESSAGE=/api/application/chat_message/{chat_id}
MAXKB_PATH_OPENAI=/v1/chat/completions

# ---------------- 业务工具 API ----------------
TOOL_API_BASE_URL=http://127.0.0.1:8100
TOOL_API_SERVICE_KEY=change-me-to-a-long-random-string
# 可选：走 tool_token 方案时才需要，要与 tool-api 一致
TOOL_TOKEN_SECRET=
TOOL_TOKEN_AUDIENCE=maxkb-tool-api
TOOL_TOKEN_TTL=1800

# ---------------- 客户身份 ----------------
# debug 仅本地联调；上线必须用 jwt 或 introspect
AUTH_MODE=debug
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHMS=HS256
AUTH_JWT_AUDIENCE=
AUTH_JWT_CUSTOMER_CLAIM=customer_id
AUTH_INTROSPECT_URL=http://customer360.internal/api/session/verify

# ---------------- 防护 ----------------
RATE_LIMIT_PER_MINUTE=20
MAX_QUESTION_CHARS=1000
MASK_USER_INPUT=true
CORS_ORIGINS=https://customer360.example.com
AUDIT_LOG_PATH=logs/audit.jsonl
